{
  "expo": {
    "name": "TransPk",
    "slug": "transpk",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#eef0fb"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "TransPk needs microphone access for voice translation."
      }
    },
    "android": {
      "package": "com.transpk.app",
      "versionCode": 1,
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#eef0fb"
      },
      "permissions": [
        "RECORD_AUDIO"
      ]
    }
  }
}